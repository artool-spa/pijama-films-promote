# Muvi API Configuration
# Get these values from CMS dashboard > Settings > Advanced
MUVI_SECRET_KEY="your_muvi_secret_key"
MUVI_APP_ID="your_muvi_app_id"
MUVI_BASE_URL="https://apigateway.muvi.com"

# Meta Ads API Configuration
# Get access token from Facebook Business Manager
META_ACCESS_TOKEN="your_meta_access_token"
META_AD_ACCOUNT_ID="your_ad_account_id"
META_PIXEL_ID="your_pixel_id"
META_PAGE_ID="your_facebook_page_id"
META_API_VERSION="v19.0"
META_BASE_URL="https://graph.facebook.com"

# Google Ads API Configuration
# Get credentials from Google Ads API Center: https://ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN="your_developer_token"
GOOGLE_ADS_CLIENT_ID="your_oauth_client_id"
GOOGLE_ADS_CLIENT_SECRET="your_oauth_client_secret"
GOOGLE_ADS_REFRESH_TOKEN="your_oauth_refresh_token"
GOOGLE_ADS_CUSTOMER_ID="your_customer_id"
# Optional: For MCC (manager) accounts
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# YouTube Data API Configuration
# If using the same OAuth app as Google Ads, these can be left empty to reuse Google Ads creds.
# Otherwise, set separate credentials with YouTube Data API scope (youtube.upload).
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""

# Google Cloud Configuration
# Used for both Storage and Gemini AI authentication
# Required: GCS bucket name
GCS_BUCKET_NAME="pijama-films-assets"
# Required: Service account credentials (JSON string or file path)
# The service account needs: Storage Object Admin, Generative Language API access
GCS_SERVICE_ACCOUNT_KEY_PATH=""
GCS_SERVICE_ACCOUNT_KEY_JSON=""
# Optional: Custom CDN URL base (defaults to https://storage.googleapis.com/{bucket})
GCS_PUBLIC_URL_BASE=""

# Session Cookie Signing
# REQUIRED. The app refuses to start without it - there is no fallback, because a
# predictable value would let anyone forge a session for any partner.
# Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Firebase (Authentication + Firestore realtime events)
#
# THERE IS NO DEFAULT ON PURPOSE. These used to read `pijama-films` — a
# DIFFERENT project that is still active — so copying this file and running
# anything pointed it at someone else's data. The same trap is documented at
# length in scripts/firestore-setup.sh, which now refuses to run rather than
# guess a project.
#
# Development uses its own Firebase project; production is
# pijama-promote-firebase. FIREBASE_PROJECT_ID and NEXT_PUBLIC_FIREBASE_PROJECT_ID
# MUST match — the server publishes events to the first and the browser reads
# them from the second, so a mismatch means events silently never arrive.
#
# Server-side (Admin SDK). Credentials come from Application Default Credentials:
# Cloud Run uses the runtime service account; locally run
#   gcloud auth application-default login
FIREBASE_PROJECT_ID=""
# Client-side (public by design, safe to ship to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""

# Stripe Configuration
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# Cron Job Authentication
CRON_SECRET="your_cron_secret_key"

# Atlas Console SSO (dashboard.pijamafilms.com, operated by Crazy Cake)
#
# Atlas opens /auth in a new window and posts a JWT over postMessage;
# POST /api/auth/atlas/session exchanges it for a Pijama session.
#
# Base URL of the Atlas API; /movies/by-partner is appended to it. NOT verified:
# probes on 2026-08-26 returned 302 for every candidate path, and
# api.pijamafilms.com does not resolve. It is an env var so it can be re-pointed
# without a code deploy.
ATLAS_API_BASE_URL="https://dashboard.pijamafilms.com"
# Gate for the `login` mode. Only the exact string "true" enables it.
ATLAS_LOGIN_ENABLED="false"
# Comma-separated partner ids allowed to log in through Atlas.
# FAIL-CLOSED: empty or absent rejects everyone. Never "empty = all".
ATLAS_LOGIN_ALLOWED_PARTNER_IDS=""
# Comma-separated origins allowed to postMessage into /auth. No wildcards.
# NEXT_PUBLIC_* is baked at build time: changing it requires a rebuild.
NEXT_PUBLIC_ATLAS_ALLOWED_ORIGINS="https://dashboard.pijamafilms.com,https://dashboard-lab.pijamafilms.com"
