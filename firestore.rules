rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Partner id carried as a custom claim, set by
    // scripts/firebase-provision-user.ts
    function partnerId() {
      return request.auth.token.partnerId;
    }

    function isSignedIn() {
      return request.auth != null && partnerId() != null;
    }

    // The "pijamafilms" partner has access to every film, mirroring
    // isSpecialPartner() in src/lib/auth/access-control.ts
    function isSpecialPartner() {
      return partnerId() == 'pijamafilms';
    }

    // Realtime event stream, one document per film.
    //
    // Film ownership lives in the external Pijama API, which rules cannot
    // reach, so the server records the authorized partners on the parent
    // document (see grantFilmEventAccess) after it has run its own check.
    match /filmEvents/{filmId} {
      // Whether the caller appears on the film's server-written allow list.
      function isAllowedOnFilm(filmDoc) {
        return filmDoc != null &&
               partnerId() in filmDoc.data.get('allowedPartnerIds', []);
      }

      allow read: if isSignedIn() &&
                     (isSpecialPartner() || isAllowedOnFilm(resource));
      // Only the Admin SDK writes here; it bypasses these rules entirely.
      allow write: if false;

      match /events/{eventId} {
        // The ACL lives on the parent document, so it has to be fetched.
        // Identical get() paths are cached within a single evaluation.
        allow read: if isSignedIn() && (
          isSpecialPartner() ||
          isAllowedOnFilm(
            get(/databases/$(database)/documents/filmEvents/$(filmId))
          )
        );
        allow write: if false;
      }
    }

    // Deny everything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
